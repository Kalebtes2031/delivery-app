# Copy to .env for local development (never commit .env)
# Expo loads EXPO_PUBLIC_* automatically (SDK 49+)

# Backend API URL (include /api/v1)
# Local development:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.100.51:8000/api/v1

# Staging / Production:
EXPO_PUBLIC_API_URL=https://backend-qine.activetechet.com/api/v1
