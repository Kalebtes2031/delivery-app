{
  "expo": {
    "name": "Elilita Delivery",
    "slug": "qine_deliveryapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/playstore.png",
    "scheme": "qinedeliveryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.active.deliveryapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Elilita Driver needs your location to navigate to pickup and delivery addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Elilita Driver tracks your location in the background to provide live delivery tracking to customers.",
        "NSLocationAlwaysUsageDescription": "Elilita Driver tracks your location while delivering orders even when the app is in the background.",
        "NSPhotoLibraryUsageDescription": "Elilita Driver needs access to your photos to update your profile picture.",
        "NSCameraUsageDescription": "Elilita Driver needs access to your camera to take a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.active.deliveryapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/playstore.png",
        "backgroundImage": "./assets/images/playstore.png",
        "monochromeImage": "./assets/images/playstore.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/playstore.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/playstore-deliveryicon.png"
        }
      ],
      "@react-native-firebase/app",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Qine Driver needs your location to track deliveries in real-time.",
          "locationAlwaysPermission": "Qine Driver needs background location access to continue tracking deliveries while the app is minimized.",
          "locationWhenInUsePermission": "Qine Driver needs your location to show your position on the map.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-localization",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edab8677-f08e-402d-816f-1dd6528cc3bd"
      }
    }
  }
}
